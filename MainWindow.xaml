<Window x:Class="LightTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightTranslate" Icon="assets/LightTranslate.ico"
        Width="568" Height="548" MinWidth="520" MinHeight="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="20">
        <Border CornerRadius="25" Background="#50000000" Margin="2,7,-2,-7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.38" Color="#FF000000" />
            </Border.Effect>
        </Border>

        <Border x:Name="WindowShell" CornerRadius="24" BorderThickness="1"
                BorderBrush="{StaticResource HairlineStrongBrush}"
                Background="{StaticResource WindowGradientBrush}">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="58" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Height="84" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#17FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Grid.Row="0" Margin="17,0,12,0" Background="Transparent"
                      PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="assets/LightTranslate-icon-ui.png" Width="31" Height="31"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LightTranslate" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="轻量 AI 翻译" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButtonStyle}" Padding="9,7" Click="Settings_Click" ToolTip="设置">
                            <TextBlock Text="设置" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Width="34" Height="32" Padding="0" Margin="3,0,0,0"
                                Click="Minimize_Click" ToolTip="最小化">
                            <TextBlock Text="−" FontSize="16" Margin="0,-3,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Width="34" Height="32" Padding="0" Margin="1,0,0,0"
                                Click="Close_Click" ToolTip="收起到托盘">
                            <TextBlock Text="×" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="18,2,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="151" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="3,0,3,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="9" Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="9,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SourceLanguageText" Text="自动识别" FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SourceLanguageCode" Text="  AUTO" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource GhostButtonStyle}" Width="34" Height="29" Padding="0" Margin="6,0"
                                    Click="SwapLanguages_Click" ToolTip="交换语言">
                                <TextBlock Text="⇄" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Border CornerRadius="9" Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="9,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TargetLanguageText" Text="简体中文" FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TargetLanguageCode" Text="  ZH" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
                            <TextBlock x:Name="ServiceStateText" Text="DeepSeek V4 Flash" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="16" Background="#0BFFFFFF"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="16,13">
                        <Grid>
                            <TextBox x:Name="SourceTextBox" Style="{StaticResource InputTextBoxStyle}"
                                     TextChanged="SourceTextBox_TextChanged" />
                            <TextBlock x:Name="SourcePlaceholder" Text="粘贴文字，或按 Ctrl + Alt + T 从剪贴板带入"
                                       FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Top" IsHitTestVisible="False" Margin="1,1,0,0" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource GhostButtonStyle}"
                                    Padding="7,4" Click="ClearSource_Click" ToolTip="清空">
                                <TextBlock Text="清空" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="3,0">
                        <Border Height="1" Background="{StaticResource HairlineBrush}" VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Center" Background="{StaticResource SurfaceBrush}" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ModeLabel" Text="均衡翻译 · HIGH" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text=" · 保留名称、路径与单位" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" CornerRadius="16" Background="#08FFFFFF"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="16,14">
                        <Grid>
                            <TextBox x:Name="TranslationTextBox" Style="{StaticResource InputTextBoxStyle}"
                                     IsReadOnly="True" FontSize="17"
                                     Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel x:Name="TranslationPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsHitTestVisible="False">
                                <Border Width="42" Height="42" CornerRadius="14" Background="#0EFFFFFF"
                                        BorderBrush="#24FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock Text="译" FontFamily="Microsoft YaHei UI" FontSize="17"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="译文会安静地出现在这里" FontSize="12.5"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="18,7,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButtonStyle}" Padding="8,7" Click="Copy_Click">
                            <TextBlock Text="复制" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Padding="8,7" Click="History_Click">
                            <TextBlock Text="历史" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Padding="8,7" Click="Explain_Click">
                            <TextBlock Text="看懂" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Padding="8,7" Click="Polish_Click">
                            <TextBlock Text="精校" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Padding="8,7" Click="Term_Click">
                            <TextBlock Text="术语" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Padding="8,7" Click="Continuous_Click">
                            <TextBlock x:Name="ContinuousButtonLabel" Text="连续" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HintText" Text="Ctrl + Enter" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="TranslateButton" Style="{StaticResource AccentButtonStyle}" Click="Translate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TranslateButtonLabel" Text="开始翻译" Foreground="#FF241F19" />
                                <TextBlock Text="  →" Foreground="#C0241F19" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
