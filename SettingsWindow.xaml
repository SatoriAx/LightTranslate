<Window x:Class="LightTranslate.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightTranslate 设置" Icon="assets/LightTranslate.ico" Width="500" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="SettingTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#0BFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrightBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingPasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#0BFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrightBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#FF202326" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FFF2EEE6" />
                        <Setter Property="Background" Value="#FF202326" />
                        <Setter Property="Padding" Value="10,7" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border CornerRadius="25" Background="#50000000" Margin="2,7,-2,-7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="7" Opacity="0.36" Color="#FF000000" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="24" BorderThickness="1" BorderBrush="{StaticResource HairlineStrongBrush}"
                Background="{StaticResource WindowGradientBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="66" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,0,14,0" Background="Transparent"
                      PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="只保留会真正影响使用体验的选项" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="35" Height="33" Padding="0"
                            Style="{StaticResource GhostButtonStyle}" Click="Close_Click">
                        <TextBlock Text="×" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,5,20,12">
                        <TextBlock Text="AI 接口" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,8" />
                        <Border CornerRadius="16" Background="#0AFFFFFF" BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1" Padding="15,14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Base URL" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox x:Name="BaseUrlBox" Style="{StaticResource SettingTextBox}" Margin="0,7,0,12"
                                         ToolTip="OpenAI-compatible 接口地址" />
                                <TextBlock Text="Model" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox x:Name="ModelBox" Style="{StaticResource SettingTextBox}" Margin="0,7,0,11" />
                                <TextBlock Text="API 类型" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox x:Name="ApiProtocolBox" Style="{StaticResource SettingComboBox}"
                                          SelectedValuePath="Tag" Margin="0,7,0,5"
                                          SelectionChanged="ApiProtocolBox_SelectionChanged">
                                    <ComboBoxItem Content="自动（推荐）" Tag="auto" IsSelected="True" />
                                    <ComboBoxItem Content="Responses API" Tag="responses" />
                                    <ComboBoxItem Content="Chat Completions" Tag="chat-completions" />
                                </ComboBox>
                                <TextBlock x:Name="ApiProtocolHintText"
                                           Text="DeepSeek 官方 V4 Flash 自动使用原生 Responses API"
                                           FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="2,0,0,11" />
                                <Grid Margin="0,0,0,11">
                                    <TextBlock Text="推理档位" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" CornerRadius="8" Background="#18D3B78F"
                                            BorderBrush="#42D3B78F" BorderThickness="1" Padding="10,4">
                                        <TextBlock Text="普通 HIGH / 看懂·精校 MAX" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrightBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="API Key" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource SettingPasswordBox}" Margin="0,7,0,9" />
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="1,0,7,0" />
                                        <TextBlock Text="使用 Windows 当前用户 DPAPI 加密"
                                                   FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button x:Name="ClearApiKeyButton" HorizontalAlignment="Right"
                                            Style="{StaticResource GhostButtonStyle}" Padding="8,4"
                                            Click="ClearApiKey_Click">
                                        <TextBlock x:Name="ClearApiKeyLabel" Text="清除密钥" FontSize="9.5"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="交互" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,8" />
                        <Border CornerRadius="16" Background="#0AFFFFFF" BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1" Padding="15,12" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox x:Name="AutoCopyCheck" Content="翻译完成后自动复制译文"
                                          Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Microsoft YaHei UI"
                                          FontSize="11.5" Margin="0,2,0,12" />
                                <CheckBox x:Name="EnhanceSmallTextCheck" Content="自动增强截图中的小文字"
                                          Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Microsoft YaHei UI"
                                          FontSize="11.5" Margin="0,0,0,12" />
                                <CheckBox x:Name="AutoHideCheck" Content="窗口失去焦点后自动收起"
                                          Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Microsoft YaHei UI"
                                          FontSize="11.5" Margin="0,0,0,12" />
                                <CheckBox x:Name="StartWithWindowsCheck" Content="随 Windows 启动"
                                          Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Microsoft YaHei UI"
                                          FontSize="11.5" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="快捷键" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,8" />
                        <Border CornerRadius="16" Background="#0AFFFFFF" BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1" Padding="15,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="剪贴板翻译" FontSize="11.5" />
                                    <TextBlock Text="截屏翻译" FontSize="11.5" Margin="0,12,0,0" />
                                    <TextBlock Text="重复上次选区" FontSize="11.5" Margin="0,12,0,0" />
                                    <TextBlock Text="连续翻译开关" FontSize="11.5" Margin="0,12,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Border CornerRadius="8" Background="#12FFFFFF" Padding="9,4">
                                        <TextBlock Text="Ctrl + Alt + T" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="8" Background="#12FFFFFF" Padding="9,4" Margin="0,7,0,0">
                                        <TextBlock Text="Ctrl + Alt + X" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="8" Background="#12FFFFFF" Padding="9,4" Margin="0,7,0,0">
                                        <TextBlock Text="Ctrl + Alt + R" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="8" Background="#12FFFFFF" Padding="9,4" Margin="0,7,0,0">
                                        <TextBlock Text="Ctrl + Alt + F" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="20,10,20,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource OutlineButtonStyle}" Click="TestConnection_Click" Padding="11,7">
                            <TextBlock Text="测试连接" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <TextBlock x:Name="SaveStateText" Text="设置保存在本机" FontSize="9.5" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="Save_Click">
                        <TextBlock Text="保存设置" Foreground="#FF241F19" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
