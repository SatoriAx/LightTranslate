<Window x:Class="LightTranslate.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="最近记录" Icon="assets/LightTranslate.ico" Width="540" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="HistoryListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemShell" CornerRadius="13" Padding="13,11"
                                Background="#08FFFFFF" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="#11FFFFFF" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="#35FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="#18D3B78F" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="#55D3B78F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Border CornerRadius="25" Background="#50000000" Margin="2,7,-2,-7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="7" Opacity="0.36" Color="#FF000000" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="24" BorderThickness="1" BorderBrush="{StaticResource HairlineStrongBrush}"
                Background="{StaticResource WindowGradientBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="66" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="20,0,14,0" Background="Transparent"
                      PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="最近记录" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="只保留最近 20 条，不保存截图" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="35" Height="33" Padding="0"
                            Style="{StaticResource GhostButtonStyle}" Click="Close_Click">
                        <TextBlock Text="×" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="20,4,20,0">
                    <ListBox x:Name="HistoryList" Style="{StaticResource HistoryListStyle}"
                             MouseDoubleClick="HistoryList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Preview}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0">
                                            <Run Text="{Binding Action}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding TargetLanguage}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontSize="9.5"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="14,1,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="还没有翻译记录" FontSize="13" HorizontalAlignment="Center" />
                        <TextBlock Text="完成翻译、看懂或精校后会出现在这里" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="20,10,20,14">
                    <Button Style="{StaticResource GhostButtonStyle}" Padding="9,7" Click="Clear_Click">
                        <TextBlock x:Name="ClearHistoryLabel" Text="清空记录"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="Load_Click">
                        <TextBlock Text="载入所选" Foreground="#FF241F19" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
