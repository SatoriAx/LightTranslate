<Window x:Class="LightTranslate.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True" Background="Black"
        PreviewKeyDown="Window_PreviewKeyDown" SourceInitialized="Window_SourceInitialized">

    <Grid x:Name="CaptureRoot" Background="Black"
          PreviewMouseLeftButtonDown="CaptureRoot_PreviewMouseLeftButtonDown"
          PreviewMouseMove="CaptureRoot_PreviewMouseMove"
          PreviewMouseLeftButtonUp="CaptureRoot_PreviewMouseLeftButtonUp"
          PreviewMouseRightButtonDown="CaptureRoot_PreviewMouseRightButtonDown">
        <Image x:Name="ScreenshotImage" Stretch="Fill" />
        <Border Background="#94000000" IsHitTestVisible="False" />

        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
            <Border x:Name="SelectionBorder" Visibility="Collapsed"
                    BorderBrush="#FFE2C79D" BorderThickness="2"
                    Background="#24E2C79D" CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.46" Color="#FFC9A36E" />
                </Border.Effect>
            </Border>
        </Canvas>

        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,28,0,0"
                CornerRadius="13" Padding="17,10" Background="#E61B1E21"
                BorderBrush="#38FFFFFF" BorderThickness="1" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#FFE2C79D" Margin="0,0,9,0" />
                <TextBlock Text="拖动选择文字区域" FontFamily="Microsoft YaHei UI" FontSize="12"
                           FontWeight="SemiBold" Foreground="#FFF7F4EE" />
                <TextBlock Text="  ·  Esc 或右键取消" FontFamily="Microsoft YaHei UI" FontSize="11"
                           Foreground="#A8F7F4EE" />
            </StackPanel>
        </Border>

        <Border x:Name="SizeBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="8" Padding="8,4" Background="#E61B1E21" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" FontFamily="Segoe UI Variable Text" FontSize="10"
                       Foreground="#DDF7F4EE" />
        </Border>
    </Grid>
</Window>
