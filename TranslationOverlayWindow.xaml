<Window x:Class="LightTranslate.TranslationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightTranslate 截图翻译" Icon="assets/LightTranslate.ico"
        Width="436" MinWidth="320" MaxWidth="560"
        MinHeight="126" MaxHeight="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown">

    <Grid Margin="18">
        <Border CornerRadius="18" Background="#65000000" Margin="2,5,-2,-5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.42" Color="#FF000000" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="17" BorderThickness="1"
                BorderBrush="{StaticResource HairlineStrongBrush}"
                Background="{StaticResource WindowGradientBrush}">
            <Grid Margin="15,12,12,11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="1,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                 Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" Text="正在识别截图"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CopyButton" Style="{StaticResource GhostButtonStyle}"
                                Padding="8,4" IsEnabled="False" Click="CopyButton_Click"
                                ToolTip="复制译文">
                            <TextBlock Text="复制" FontSize="10.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Width="27" Height="25"
                                Padding="0" Margin="2,0,0,0" Click="CloseButton_Click"
                                ToolTip="关闭">
                            <TextBlock Text="×" FontSize="15"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" CornerRadius="12" Background="#0BFFFFFF"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                        Padding="13,10">
                    <TextBox x:Name="ResultTextBox" IsReadOnly="True"
                             Text="正在读取选区中的文字…"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
                             FontSize="15.5"
                             Foreground="{StaticResource TextMutedBrush}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="50" MaxHeight="224"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             SelectionBrush="#75C6A578" CaretBrush="{StaticResource AccentBrightBrush}" />
                </Border>

                <Grid Grid.Row="2" Margin="2,8,2,0">
                    <TextBlock x:Name="DetailText" Text="截图留在本机，仅发送识别后的文字"
                               FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="右键关闭"
                               HorizontalAlignment="Right" FontSize="9.5"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
