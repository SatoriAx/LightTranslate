<Window x:Class="LightTranslate.TerminologyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="个人术语" Icon="assets/LightTranslate.ico" Width="520" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Border CornerRadius="25" Background="#50000000" Margin="2,7,-2,-7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="7" Opacity="0.36" Color="#FF000000" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="24" BorderThickness="1" BorderBrush="{StaticResource HairlineStrongBrush}"
                Background="{StaticResource WindowGradientBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="66" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="20,0,14,0" Background="Transparent"
                      PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="个人术语" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="匹配到原文时，优先使用你指定的译法" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="35" Height="33" Padding="0"
                            Style="{StaticResource GhostButtonStyle}" Click="Close_Click">
                        <TextBlock Text="×" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="20,4,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="11" Background="#12D3B78F" BorderBrush="#35D3B78F" BorderThickness="1"
                            Padding="12,8" Margin="0,0,0,12">
                        <TextBlock Text="每行一条：原词 = 指定译法　　以 # 开头的行会被忽略"
                                   FontSize="10.5" Foreground="{StaticResource AccentBrightBrush}" />
                    </Border>
                    <Border Grid.Row="1" CornerRadius="16" Background="#0BFFFFFF"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="15,13">
                        <TextBox x:Name="TermsTextBox" Style="{StaticResource InputTextBoxStyle}" FontSize="14"
                                 AcceptsTab="True" VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="20,10,20,14">
                    <TextBlock x:Name="StateText" Text="最多保存 200 条，仅存于本机" FontSize="9.5"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,116,0" TextTrimming="CharacterEllipsis" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="Save_Click">
                        <TextBlock Text="保存术语" Foreground="#FF241F19" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
